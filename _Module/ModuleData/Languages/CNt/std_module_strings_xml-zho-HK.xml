                <string id="BMGrowPercentDesc" text="每種兵種的數量按此百分比成長。"/>
                <string id="BMTier" text="訓練可達最高兵種階級"/>
                <string id="BMTierDesc" text="訓練不會把兵種升級到超過此階級。"/>

                <string id="BMIgnore" text="忽略村民／商隊"/>
                <string id="BMIgnoreDesc" text="強盜兵團不會攻擊他們。"/>
                <string id="BMExecHonorXp" text="處決兵團首領的榮譽經驗"/>
                <string id="BMExecHonorXpDesc" text="玩家處決強盜兵團首領時獲得的榮譽特質經驗。0 為停用。"/>
