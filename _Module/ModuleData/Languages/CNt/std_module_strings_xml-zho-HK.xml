                <string id="BMRCaptiveExecuteAnswer" text="那就動作快點。我的弟兄們會記住你的臉——他們會來找你算帳的。"/>
                <string id="BMRCaptiveExecuteConfirm" text="我不在乎。受死吧！"/>
                <string id="BMRCaptiveExecuteCancel" text="好吧。你現在是我的俘虜。"/>

